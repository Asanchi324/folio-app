# Copy this file to .env.local and fill in your keys.
# .env.local must never be committed — it holds secrets.

# ── AI providers ───────────────────────────────────────────────────────────
# Folio tries them in order: Groq → OpenRouter → Gemini. Fill in any you have;
# blanks are skipped. Groq + OpenRouter are the free, high-quota options.

# Groq — free, no card. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the default Groq model
GROQ_MODEL=

# OpenRouter — free models. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: pick a free model slug from https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=

# Gemini — last resort. Free quota is per Google Cloud PROJECT, so for more free
# requests create several projects and list one key from each, comma-separated.
# NOTE: keys must start with "AIza"; "AQ." keys are account-restricted (~20/day).
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Firebase web app config (Firebase console → Project settings → your web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Analytics 4 — Measurement ID from the GA4 admin (looks like G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# All optional: without them, checkout degrades to the concierge (mailto) flow.
# 1. stripe.com → create 3 recurring Prices: Pro $9/mo, Business $149/mo,
#    Business Plus $299/mo. Paste the price ids below.
# 2. Developers → Webhooks → endpoint {SITE_URL}/api/webhooks/billing with
#    events: checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted, invoice.payment_failed.
# 3. FIREBASE_SERVICE_ACCOUNT_JSON (below) is required for the webhook to
#    write plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_PLUS=

# Firebase service account JSON (single line) — lets the webhook write plans.
# Firebase console → Project settings → Service accounts → Generate key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Canonical site URL — used for Stripe redirect URLs, sitemap and OG meta.
NEXT_PUBLIC_SITE_URL=https://foli0.vercel.app

# ── B2B / founder admin ─────────────────────────────────────────────────────
# The founder email djdjdj.9413@gmail.com is baked into lib/plans.js and
# firestore.rules (auto-grant: founder gets Pro + a Business workspace on
# sign-in). This optional env var EXTENDS the founder list (comma-separated) —
# any email added here must also be added to isFounder() in firestore.rules.
FOLIO_ADMIN_EMAILS=

# ── Optional: durable rate limiting (recommended once traffic grows) ────────
# Free Redis at upstash.com → REST API. Without these, limits are per-instance
# in-memory (fine at small scale).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
