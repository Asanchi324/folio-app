// Folio — Firestore security rules (B2C + B2B model).
// Paste into Firebase console → Firestore Database → Rules → Publish.
//
// ┌─────────────────────────────────────────────────────────────────────┐
// │ OWNER ACTION REQUIRED: put YOUR Google account email(s) into the    │
// │ isFounder() list below. Founders can set plans/seats and see all    │
// │ orgs — this is the manual "billing" path until payments exist.      │
// │ Keep it in sync with the FOLIO_ADMIN_EMAILS env var on Vercel.      │
// └─────────────────────────────────────────────────────────────────────┘
//
// Access matrix (enforced here, mirrored in the UI):
//   student   → own portfolio/user doc; sees & resolves own comments
//   counselor → read-only portfolios + comments for students of THEIR org
//   orgAdmin  → same as counselor + manages the org doc and members
//   founder   → everything above + sets plan/seats (manual sales)
//   public    → shares/{shareId} snapshots only (unguessable random ids)
//
// Plans ('free'|'pro' on users, 'free'|'business'|'businessPlus' on orgs) are
// the paid gates, so clients may NEVER write them: users/orgs create must
// start at 'free' and updates must keep plan unchanged. Plans are flipped only
// by the Stripe webhook (service account — bypasses rules) or a founder.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Founder admins — EDIT THIS LIST (must match FOLIO_ADMIN_EMAILS env).
    // email_verified is essential: if an email/password provider is ever
    // enabled, anyone could register an unverified account with this address.
    function isFounder() {
      return signedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ['djdjdj.9413@gmail.com'];
    }

    function orgDoc(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)).data;
    }
    function orgCodes(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/private/codes).data;
    }
    function isMember(orgId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }
    function memberRole(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role;
    }
    // Staff = counselor or orgAdmin of that org.
    function isOrgStaff(orgId) {
      return isMember(orgId) && memberRole(orgId) in ['counselor', 'orgAdmin'];
    }
    function isOrgAdmin(orgId) {
      return signedIn() &&
        (orgDoc(orgId).ownerUid == request.auth.uid ||
         (isMember(orgId) && memberRole(orgId) == 'orgAdmin'));
    }

    // ---------- users/{uid} — platform profile ----------
    // A self-written staff role must be backed by a real membership with that
    // same role in the org the doc points at (checked with getAfter so the
    // join/create-org batches — member doc + user doc in one commit — pass).
    function roleWriteOk() {
      return request.resource.data.role == 'student' ||
        (request.resource.data.orgId != null &&
          getAfter(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)/members/$(request.auth.uid)).data.role == request.resource.data.role);
    }
    // Billing fields are written ONLY by the Stripe webhook (service account,
    // bypasses rules) or a founder — a client faking stripeCustomerId could
    // otherwise open someone else's billing portal.
    function noBillingFieldsOnCreate() {
      return !request.resource.data.keys().hasAny(
        ['stripeCustomerId', 'stripeSubscriptionId', 'dodoCustomerId', 'dodoSubscriptionId', 'planUpdatedAt', 'founder',
         'subscriptionStatus', 'currentPeriodEnd', 'cancelAtPeriodEnd']);
    }
    function billingFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['stripeCustomerId', 'stripeSubscriptionId', 'dodoCustomerId', 'dodoSubscriptionId', 'planUpdatedAt', 'founder',
         'subscriptionStatus', 'currentPeriodEnd', 'cancelAtPeriodEnd']);
    }
    match /users/{uid} {
      allow read: if isSelf(uid) || isFounder();
      // First sign-in bootstrap: plan MUST be free, role must be legitimate,
      // no billing fields.
      allow create: if isSelf(uid) &&
        request.resource.data.plan == 'free' &&
        noBillingFieldsOnCreate() &&
        roleWriteOk();
      // Self-updates may touch anything EXCEPT plan/billing (paid gates), and
      // a role claim must match an actual org membership — no self-promotion
      // to counselor/orgAdmin without one. Founders can change everything.
      allow update: if isFounder() ||
        (isSelf(uid) &&
          request.resource.data.plan == resource.data.plan &&
          billingFieldsUntouched() &&
          (request.resource.data.role == resource.data.role || roleWriteOk()));
      allow delete: if isFounder();
    }

    // ---------- orgs ----------
    match /orgs/{orgId} {
      // Members see their org (name, codes for admins UI, plan). Owners too
      // (covers the moment right after creation). Founders see all (console).
      allow read: if isFounder() || isMember(orgId) ||
        (signedIn() && resource.data.ownerUid == request.auth.uid);
      // Self-serve workspace creation — must start on the free plan, and can
      // never smuggle billing fields in (Stripe writes those via the webhook).
      // counselorCode may NOT live here: every member can read this doc.
      allow create: if isFounder() ||
        (signedIn() &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.plan == 'free' &&
          !request.resource.data.keys().hasAny(
            ['stripeCustomerId', 'stripeSubscriptionId', 'dodoCustomerId', 'dodoSubscriptionId', 'planUpdatedAt', 'counselorCode']));
      // Admins manage the org but can ONLY touch cosmetic fields — plan/seats
      // are billing (webhook/founder-only), codes + ownerUid stay stable.
      // Exception: removing a legacy counselorCode (migration to private/codes).
      allow update: if isFounder() ||
        (isOrgAdmin(orgId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'type', 'brandName', 'settings', 'counselorCode']) &&
          !('counselorCode' in request.resource.data));
      allow delete: if isFounder();

      // ---------- private/codes — staff invite code, admins only ----------
      // Created in the same batch as the org (getAfter) or by the legacy
      // migration, which must copy the org's existing code verbatim.
      match /private/{docId} {
        allow read: if isFounder() || isOrgAdmin(orgId);
        allow create: if isFounder() ||
          (docId == 'codes' && signedIn() &&
            request.resource.data.keys().hasOnly(['counselorCode']) &&
            (getAfter(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid == request.auth.uid ||
              isOrgAdmin(orgId)) &&
            (!exists(/databases/$(database)/documents/orgs/$(orgId)) ||
              request.resource.data.counselorCode == orgDoc(orgId).get('counselorCode', null)));
        allow update, delete: if isFounder();
      }

      // ---------- membership ----------
      match /members/{memberUid} {
        // A member sees their own membership; staff see the whole roster.
        allow read: if isSelf(memberUid) || isOrgStaff(orgId) || isFounder();
        // Joining is self-service but code-verified: the new member doc must
        // carry the org's CURRENT invite code for the role it claims. This is
        // what lets /join/{code} work without Cloud Functions.
        // A third path: a counselor invited this student by email — the
        // invite doc (invites/{orgId}_{email}) must exist for the signed-in
        // user's verified email.
        allow create: if isFounder() || isOrgAdmin(orgId) ||
          (isSelf(memberUid) &&
            request.resource.data.joinedAt is number &&
            (
              (request.resource.data.role == 'student' &&
                request.resource.data.joinCode == orgDoc(orgId).joinCode) ||
              (request.resource.data.role == 'counselor' &&
                request.resource.data.joinCode == orgCodes(orgId).counselorCode) ||
              (request.resource.data.role == 'student' &&
                request.auth.token.email_verified == true &&
                request.resource.data.inviteId == orgId + '_' + request.auth.token.email.lower() &&
                exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)))
            ));
        // Members can always leave; admins can remove anyone.
        allow delete: if isSelf(memberUid) || isOrgAdmin(orgId) || isFounder();
        allow update: if isOrgAdmin(orgId) || isFounder();
      }
    }

    // ---------- joinCodes/{CODE} — invite-code lookup ----------
    // Read requires being signed in AND knowing the exact code (doc id) — the
    // collection can't be listed, so codes stay effectively secret.
    // Only the org's owner (checked with getAfter so the create-org batch
    // passes) or a founder may mint codes — nobody can squat code names or
    // point a code at someone else's org.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if isFounder();
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        (isFounder() ||
          getAfter(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)).data.ownerUid == request.auth.uid);
      allow update: if false;
      allow delete: if isFounder() ||
        (signedIn() && resource.data.createdBy == request.auth.uid) ||
        isOrgAdmin(resource.data.orgId);
    }

    // ---------- invites/{orgId}_{email} — counselor adds a student by email ----------
    // The invitee reads (and can decline = delete) invites addressed to their
    // verified email; the org's staff create, list and revoke them. The doc id
    // is pinned to orgId + lower-cased email so it can't be spoofed.
    match /invites/{inviteId} {
      function myEmail() {
        return request.auth.token.email.lower();
      }
      function validInvite() {
        return request.resource.data.email is string &&
          request.resource.data.email == request.resource.data.email.lower() &&
          inviteId == request.resource.data.orgId + '_' + request.resource.data.email &&
          request.resource.data.invitedBy == request.auth.uid &&
          isOrgStaff(request.resource.data.orgId);
      }
      allow read: if signedIn() &&
        ((request.auth.token.email_verified == true && resource.data.email == myEmail()) ||
          isOrgStaff(resource.data.orgId) || isFounder());
      allow create, update: if signedIn() && validInvite();
      allow delete: if signedIn() &&
        (resource.data.email == myEmail() || isOrgStaff(resource.data.orgId) || isFounder());
    }

    // ---------- portfolios/{uid} ----------
    match /portfolios/{uid} {
      // Owner always; org staff read the portfolios of students linked to
      // their org (the student links/unlinks the orgId themselves — that IS
      // the consent switch). NO public read here, ever — sharing goes through
      // the curated shares/{shareId} snapshots instead.
      allow read: if isSelf(uid) || isFounder() ||
        (resource.data.orgId != null && isOrgStaff(resource.data.orgId));
      allow write: if isSelf(uid);
      // Org staff may UNLINK a removed student (clear the org fields, nothing
      // else) so the roster and the student's UI stay consistent after a
      // removal. They still can't modify portfolio content.
      allow update: if isSelf(uid) ||
        (resource.data.orgId != null && isOrgStaff(resource.data.orgId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['orgId', 'orgName', 'counselorId']) &&
          request.resource.data.orgId == null);

      // ---------- counselor comments ----------
      match /comments/{commentId} {
        function portfolioOrgId() {
          return get(/databases/$(database)/documents/portfolios/$(uid)).data.orgId;
        }
        allow read: if isSelf(uid) ||
          (portfolioOrgId() != null && isOrgStaff(portfolioOrgId()));
        // Only org staff comment, and only under their own name.
        allow create: if portfolioOrgId() != null &&
          isOrgStaff(portfolioOrgId()) &&
          request.resource.data.authorUid == request.auth.uid;
        // The student may toggle `resolved` (and nothing else); the author may
        // edit their own comment.
        allow update: if (signedIn() && request.auth.uid == resource.data.authorUid) ||
          (isSelf(uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']));
        allow delete: if signedIn() && request.auth.uid == resource.data.authorUid;
      }

      // ---------- AI counselor chat history (private to the student) ----------
      match /chat/{msgId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---------- shares/{shareId} — public curated snapshots ----------
    // Doc ids are long random strings generated client-side; knowing the id IS
    // the capability. Content is a snapshot the student explicitly curated.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false; // no enumeration
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      // Only the existing owner may update, and ownership can never move —
      // otherwise anyone who knows a shareId could hijack it by writing
      // their own uid into ownerUid.
      allow update: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- server-only namespaces (webhook audit, durable cache/limits) ----------
    // billing_events is written by the payment webhook via service account
    // (bypasses rules); founders may read it for the audit trail.
    match /billing_events/{doc} {
      allow read: if isFounder();
      allow write: if false;
    }
    match /rate_limits/{doc} { allow read, write: if false; }
    match /ai_cache/{doc} { allow read, write: if false; }
  }
}
